# Port to listen on
PORT=3000

# Network interface to bind. Defaults to 127.0.0.1 (loopback only).
# Set to 0.0.0.0 only when the port is deliberately exposed and firewalled.
HOST=127.0.0.1

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/mcp-proxy

# Bearer token required by every /admin/api route. Without it the admin API is
# disabled. Must be at least 16 characters - generate one with:
#   openssl rand -hex 32
ADMIN_TOKEN=

# Comma-separated list of origins allowed to call this server from a browser.
# Empty means no cross-origin access. "*" allows any origin (insecure).
CORS_ORIGINS=

# Hosts an application's backendUrl may point at, comma-separated. An entry may
# start with "*." to also match subdomains. When empty, any public host is
# allowed but loopback, private, link-local and cloud-metadata addresses are
# refused. When set, only these hosts are reachable - and they are trusted, so
# use it for backends on private networks.
#   e.g. BACKEND_ALLOWED_HOSTS=api.mycompany.com,*.internal.corp,192.168.1.50
BACKEND_ALLOWED_HOSTS=

# Set to true to permit http:// backend URLs. Backends must use https otherwise.
BACKEND_ALLOW_HTTP=

# Total deadline for a backend call, in milliseconds. Defaults to 15000. Raise it
# for tools whose backend is slow to answer.
BACKEND_TIMEOUT_MS=

# Largest backend response the proxy will read, in bytes. Defaults to 1048576 (1 MiB).
BACKEND_MAX_RESPONSE_BYTES=

LOG_LEVEL=info
